{
  "name": "@copperbox/millwright-cli",
  "version": "0.6.1",
  "description": "millwright CLI — operate a millwright deployment from operator and developer machines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/copperbox/millwright.git",
    "directory": "packages/millwright-cli"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "millwright": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run bundle-synth-job",
    "bundle-synth-job": "esbuild src/synth-job/main.ts --bundle --platform=node --target=node22 --outfile=dist/synth-job.bundle.js --log-level=warning",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1108.0",
    "@aws-sdk/client-dynamodb": "^3.1108.0",
    "@aws-sdk/client-ecr": "^3.1108.0",
    "@aws-sdk/client-eventbridge": "^3.1108.0",
    "@aws-sdk/client-iam": "^3.1108.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-service-quotas": "^3.1108.0",
    "@aws-sdk/client-sfn": "^3.1108.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.1108.0",
    "@copperbox/millwright-state": "^0.6.1",
    "@copperbox/millwright-workflows": "^0.6.1",
    "commander": "^12.1.0",
    "ssh2": "^1.17.0",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5",
    "esbuild": "^0.28.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
